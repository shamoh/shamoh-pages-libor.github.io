---
import { site } from '../site';
import EmailLink from './EmailLink.astro';
---

<div class="social-links">
  <EmailLink class="author-social" target="_blank"><i class="fa fa-2x fa-envelope-square"></i></EmailLink>
  <a href={`https://twitter.com/${site.twitter}`} class="author-social" target="_blank" aria-label="Twitter"><i class="fa fa-2x fa-twitter-square"></i></a>
  <a href={`https://facebook.com/${site.facebook}`} class="author-social" target="_blank" aria-label="Facebook"><i class="fa fa-2x fa-facebook-square"></i></a>
  <a href={`https://linkedin.com/in/${site.linkedin}`} class="author-social" target="_blank" aria-label="LinkedIn"><i class="fa fa-2x fa-linkedin-square"></i></a>
  <a href={`https://github.com/${site.github}`} class="author-social" target="_blank" aria-label="GitHub"><i class="fa fa-2x fa-github"></i></a>
  <a href={`https://stackoverflow.com/users/${site.stackoverflow}`} class="author-social" target="_blank" aria-label="Stack Overflow"><i class="fa fa-2x fa-stack-overflow"></i></a>
</div>
