---
// The list of the abbreviations a page uses (explained also in the printed PDF, where tooltips do not work).
import { used } from '../lib/abbr';

interface Props {
  /** all the plain texts the page shows */
  texts: (string | undefined)[];
  /** list also the abbreviations every developer knows (API, HTTP, …); they keep their tooltip anyway */
  common?: boolean;
}

const { texts, common = true } = Astro.props;
const terms = used(texts).filter((term) => common || !term.common);
---

{terms.length > 0 && (
  <section class="section">
    <h2 class="label">Abbreviations</h2>
    <dl class="abbreviations">
      {terms.map(({ term, title }) => (
        <div>
          <dt>{term}</dt>
          <dd>{title}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
