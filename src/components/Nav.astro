---
import { site } from '../site';

interface Props {
  /** "home": the menu of the home page and of the mobile menu, "main": the top menu of the other pages */
  variant: 'home' | 'main';
}

const { variant } = Astro.props;
const external = (url: string) => url.startsWith('http');
---

{variant === 'home' ? (
  <nav class="nav-home">
    <ul class="menu">
      {site.navigation.map((link) => (
        <li><a class="link" href={link.url} target={external(link.url) ? '_blank' : undefined}>{link.title}</a></li>
      ))}
    </ul>
  </nav>
) : (
  <nav class="nav">
    <ul class="menuAna">
      {site.navigation.map((link) => (
        <li class="item"><a class="link" href={link.url} target={external(link.url) ? '_blank' : undefined}>{link.title}</a></li>
      ))}
    </ul>
  </nav>
)}
