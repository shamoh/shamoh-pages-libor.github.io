---
import Entry from '../components/Entry.astro';
import Base from '../layouts/Base.astro';
import { getPositions } from '../lib/cv';
import { site } from '../site';

const positions = (await getPositions()).slice(0, 4);
---

<Base>
  <section class="hero">
    <img class="avatar" src={site.picture} alt="" width="88" height="88" />
    <h1 class="display">Software architect <em>and Java developer since 1997.</em></h1>
    <p class="intro">
      I design and build backend systems, frameworks and APIs. From NetBeans IDE at Sun Microsystems, through
      the Java EE platform of Komerční banka and Jersey and Helidon at Oracle, to a cloud-native banking platform
      and backend services in Scala, Java and Go as a freelancer.
    </p>
    <p class="actions">
      <a class="button" href="/cv/">Curriculum vitae</a>
      <a href="/about/">About me</a>
    </p>
  </section>

  <section class="section">
    <h2 class="label">Recent experience</h2>
    <div>
      {positions.map(({ data }) => (
        <Entry start={data.start} end={data.end} title={data.role} place={data.company} />
      ))}
      <p class="more"><a href="/cv/#experience">Full experience →</a></p>
    </div>
  </section>

  <section class="section">
    <h2 class="label">Elsewhere</h2>
    <ul class="links">
      {site.links.map((link) => (
        <li>
          <a href={link.url}>{link.title}</a>
          <span>{link.handle}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(3rem, 8vw, 5rem);
    max-width: 52rem;
  }
  .avatar {
    display: block;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    margin-bottom: 2.5rem;
    filter: grayscale(1);
    border: 1px solid var(--line);
  }
  .intro {
    max-width: var(--measure);
    margin-top: 1.75rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }
  .button {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    font-weight: 500;
  }
  .button:hover {
    background: var(--accent);
    color: #fff;
  }
  .more {
    margin: 2rem 0 0;
    font-size: 0.9375rem;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1rem 2rem;
  }
  .links li {
    display: grid;
  }
  .links span {
    font: 400 0.8125rem/1.6 var(--mono);
    color: var(--faint);
  }
</style>
