---
// The whole career in detail: every position, the selected projects by client, all certificates and education.
// The short version is /cv/.
import Abbreviations from '../../../components/Abbreviations.astro';
import CvIntro from '../../../components/CvIntro.astro';
import Entry from '../../../components/Entry.astro';
import Base from '../../../layouts/Base.astro';
import { abbr } from '../../../lib/abbr';
import { getCertifications, getEducation, getPositions, getProjects } from '../../../lib/cv';
import { site } from '../../../site';
import '../../../styles/cv.css';

const positions = await getPositions();
const projects = await getProjects();
const certifications = await getCertifications();
const education = await getEducation();

// projects grouped by their client, the client of the newest project first
const clients = [...new Set(projects.map((project) => project.data.client))].map((client) => ({
  client,
  projects: projects.filter((project) => project.data.client === client),
}));

const texts = [
  ...positions.flatMap(({ data }) => [data.role, data.company, data.location, data.summary, ...data.highlights]),
  ...projects.flatMap(({ data }) => [data.client, data.name, data.summary, ...data.highlights, ...data.technologies]),
  ...certifications.flatMap(({ data }) => [data.name, data.note]),
  ...education.flatMap(({ data }) => [data.degree, data.school, data.thesis, data.note]),
];
---

<Base title="Career history" description={`The whole career of ${site.name} in detail: positions, projects, certificates.`}>
  <CvIntro label="Career history" other={{ title: '← Short CV', url: '/cv/' }} />

  <section class="section" id="experience">
    <h2 class="label">Experience</h2>
    <div>
      {positions.map(({ data }) => (
        <Entry
          start={data.start}
          end={data.end}
          title={data.role}
          place={[data.company, data.location].filter(Boolean).join(', ')}
          summary={data.summary}
          highlights={data.highlights}
        />
      ))}
    </div>
  </section>

  <section class="section" id="projects">
    <h2 class="label">Selected projects</h2>
    <div>
      {clients.map((group) => (
        <div class="client">
          <h3 class="client-name" set:html={abbr(group.client)} />
          {group.projects.map(({ data }) => (
            <Entry start={data.start} end={data.end} title={data.name} summary={data.summary} highlights={data.highlights} technologies={data.technologies} />
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="label">Certificates</h2>
    <ul class="certificates">
      {certifications.map(({ data }) => (
        <li>
          <span class="cert-name" set:html={abbr(data.name)} />
          <span class="cert-meta">{data.issuer}, {data.month ? `${data.month}/` : ''}{data.year}</span>
          {data.note && <span class="cert-note" set:html={abbr(data.note)} />}
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="label">Education</h2>
    <div>
      {education.map(({ data }) => (
        <Entry start={data.start} end={data.end} title={data.degree} place={data.school}>
          {data.thesis && <p set:html={abbr(`Thesis: ${data.thesis}`)} />}
          {data.note && <p set:html={abbr(data.note)} />}
        </Entry>
      ))}
    </div>
  </section>

  <Abbreviations texts={texts} />
</Base>

<style>
  .client + .client {
    margin-top: 2.75rem;
  }
  .client-name {
    font-family: var(--serif);
    font-size: 1.75rem;
    margin-bottom: 1.25rem;
  }
  .certificates {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .certificates li {
    display: grid;
    break-inside: avoid;
  }
  .cert-name {
    font-weight: 600;
  }
  .cert-note {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .cert-meta {
    font: 400 0.8125rem/1.6 var(--mono);
    color: var(--faint);
  }
  @media print {
    .client {
      break-inside: auto;
    }
    .client-name {
      font-size: 1.25rem;
      break-after: avoid;
    }
  }
</style>
