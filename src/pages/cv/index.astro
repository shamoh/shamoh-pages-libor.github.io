---
// The CV on one page: the profile, the key positions of the last years in full, skills and a one-line overview of the
// earlier career. All the details are on /cv/history/.
import { getCollection } from 'astro:content';
import Abbreviations from '../../components/Abbreviations.astro';
import CvIntro from '../../components/CvIntro.astro';
import Base from '../../layouts/Base.astro';
import { abbr, paragraphs } from '../../lib/abbr';
import { getCertifications, getEducation, getPositions } from '../../lib/cv';
import profile from '../../texts/profile.md?raw';
import { period, site } from '../../site';
import '../../styles/cv.css';

const positions = await getPositions();
const featured = positions.filter((position) => position.data.featured);
// consecutive positions at one company (three at Komerční banka) make one line: its years, the latest role and
// the summaries from the oldest
const earlier = positions
  .filter((position) => !position.data.featured)
  .reduce<{ data: (typeof positions)[number]['data'] }[]>((lines, { data }) => {
    const last = lines.at(-1);
    if (last && last.data.company === data.company) {
      last.data = { ...last.data, start: data.start, summary: `${data.summary} ${last.data.summary}` };
    } else {
      lines.push({ data: { ...data } });
    }
    return lines;
  }, []);
const skills = await getCollection('skills');
const group = (name: string) =>
  skills
    .filter((skill) => skill.data.group === name)
    .map((skill) => skill.data)
    .sort((a, b) => (a.rank ?? 99) - (b.rank ?? 99) || a.name.localeCompare(b.name));
const certifications = await getCertifications();
const education = await getEducation();
const languages = await getCollection('languages');

const texts = [
  profile,
  ...featured.flatMap(({ data }) => [data.role, data.summary, ...data.highlights, ...data.technologies]),
  ...earlier.flatMap(({ data }) => [data.role, data.company, data.summary]),
  ...skills.map((skill) => skill.data.name),
  ...certifications.map((certification) => certification.data.name),
  ...education.flatMap(({ data }) => [data.degree, data.school]),
];
---

<Base title="Curriculum Vitae" description={`Curriculum vitae of ${site.name}, ${site.tagline}.`}>
  <CvIntro label="Curriculum vitae" other={{ title: 'Full history →', url: '/cv/history/' }} />

  <section class="section">
    <h2 class="label">Profile</h2>
    <div class="prose">{paragraphs(profile).map((paragraph) => <p set:html={paragraph} />)}</div>
  </section>

  <section class="section" id="experience">
    <h2 class="label">Recent work</h2>
    <div class="featured">
      {featured.map(({ data }) => (
        <article class="card">
          <header>
            <h3>{data.company}</h3>
            <p class="label">{period(data.start, data.end)}</p>
          </header>
          <p class="role" set:html={abbr([data.role, data.location].filter(Boolean).join(' · '))} />
          <p class="lead" set:html={abbr(data.summary)} />
          {data.highlights.length > 0 && (
            <ul class="highlights">
              {data.highlights.map((highlight) => <li set:html={abbr(highlight)} />)}
            </ul>
          )}
          {data.technologies.length > 0 && (
            <ul class="chips">
              {data.technologies.map((technology) => <li set:html={abbr(technology)} />)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="label">Skills</h2>
    <div class="skills">
      <div>
        <h3 class="skill-group">Languages</h3>
        <ul class="plain">
          {group('language').map((skill) => (
            <li>{skill.name}{skill.note && <span class="note"> · {skill.note}</span>}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="skill-group">Approach</h3>
        <ul class="plain">
          {group('approach').map((skill) => <li set:html={abbr(skill.name)} />)}
        </ul>
      </div>
      <div>
        <h3 class="skill-group">Tools</h3>
        <ul class="chips">
          {group('tool').map((skill) => <li set:html={abbr(skill.name)} />)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <h2 class="label">Earlier career</h2>
    <div>
      <ol class="timeline">
        {earlier.map(({ data }) => (
          <li>
            <span class="label">{period(data.start, data.end)}</span>
            <span>
              <strong set:html={abbr(data.company)} /> · <span set:html={abbr(data.role)} />
              <span class="note" set:html={abbr(data.summary)} />
            </span>
          </li>
        ))}
      </ol>
      <p class="more no-print"><a href="/cv/history/">All positions and projects in detail →</a></p>
    </div>
  </section>

  <section class="section">
    <h2 class="label">Certificates</h2>
    <ul class="plain columns">
      {certifications.map(({ data }) => (
        <li><span set:html={abbr(data.name)} /> <span class="note">· {data.month ? `${data.month}/` : ''}{data.year}</span></li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="label">Education & languages</h2>
    <div>
      {education.map(({ data }) => (
        <p class="edu">
          <strong set:html={abbr(data.degree)} />, {data.school}
          <span class="note"> · {period(data.start, data.end)}</span>
        </p>
      ))}
      <p class="edu">
        {languages.map(({ data }, i) => (
          <>{i > 0 && ' · '}{data.name} <span class="note">({data.level})</span></>
        ))}
      </p>
    </div>
  </section>

  <Abbreviations texts={texts} />
</Base>

<style>
  .featured {
    display: grid;
    gap: 1.25rem;
  }
  .card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    break-inside: avoid;
  }
  .card header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .card h3 {
    font-family: var(--serif);
    font-size: 2rem;
  }
  .role {
    margin: 0.25rem 0 0;
    font-weight: 600;
  }
  .lead {
    margin: 0.75rem 0 0;
    font-size: 1.0625rem;
  }
  .highlights {
    margin: 0.75rem 0 1rem;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .highlights li + li {
    margin-top: 0.25rem;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }
  .skill-group {
    font: 600 0.9375rem var(--sans);
    margin-bottom: 0.6rem;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .columns {
    display: block;
    columns: 2 18rem;
    column-gap: 2rem;
  }
  .columns li {
    break-inside: avoid;
    margin-bottom: 0.3rem;
  }
  .note {
    color: var(--faint);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0 1.5rem;
    break-inside: avoid;
  }
  .timeline .label {
    padding-top: 0.2rem;
  }
  .timeline .note {
    display: block;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .more {
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
  }
  .edu {
    margin: 0 0 0.4rem;
  }
  @media (max-width: 48rem) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 36rem) {
    .timeline li {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 1.25rem;
    }
  }
  @media print {
    .card {
      padding: 1rem 1.25rem;
    }
    .card h3 {
      font-size: 1.5rem;
    }
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
