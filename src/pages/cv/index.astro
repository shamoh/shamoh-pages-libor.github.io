---
import { getCollection } from 'astro:content';
import EmailLink from '../../components/EmailLink.astro';
import Entry from '../../components/Entry.astro';
import Base from '../../layouts/Base.astro';
import { getCertifications, getEducation, getPositions, getProjects } from '../../lib/cv';
import { Content as Profile } from '../../texts/profile.md';
import { site } from '../../site';

const positions = await getPositions();
const projects = await getProjects();
const education = await getEducation();
const certifications = await getCertifications();
const languages = await getCollection('languages');
const skills = await getCollection('skills');

// projects grouped by their client, the client of the newest project first
const clients = [...new Set(projects.map((project) => project.data.client))].map((client) => ({
  client,
  projects: projects.filter((project) => project.data.client === client),
}));
---

<Base title="Curriculum Vitae" description={`Curriculum vitae of ${site.name}, ${site.tagline}.`}>
  <section class="intro">
    <p class="label">Curriculum vitae</p>
    <h1 class="display">{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <ul class="contact">
      <li><EmailLink><Fragment set:html={site.email} /></EmailLink></li>
      <li><a href={site.url}>{new URL(site.url).host}</a></li>
      {site.links.slice(0, 2).map((link) => <li><a href={link.url}>{link.title}</a></li>)}
      <li class="no-print"><button type="button" class="print">Save as PDF</button></li>
    </ul>
  </section>

  <section class="section">
    <h2 class="label">Profile</h2>
    <div class="prose"><Profile /></div>
  </section>

  <section class="section" id="experience">
    <h2 class="label">Experience</h2>
    <div>
      {positions.map(({ data }) => (
        <Entry
          start={data.start}
          end={data.end}
          title={data.role}
          place={[data.company, data.location].filter(Boolean).join(', ')}
          highlights={data.highlights}
        />
      ))}
    </div>
  </section>

  <section class="section" id="projects">
    <h2 class="label">Selected projects</h2>
    <div>
      {clients.map((group) => (
        <div class="client">
          <h3 class="client-name">{group.client}</h3>
          {group.projects.map(({ data }) => (
            <Entry start={data.start} end={data.end} title={data.name} highlights={data.highlights} technologies={data.technologies}>
              {data.summary && <p>{data.summary}</p>}
            </Entry>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="label">Skills</h2>
    <ul class="facts">
      {skills.map(({ data }) => <li>{data.name}{data.note && <span> {data.note}</span>}</li>)}
    </ul>
  </section>

  <section class="section">
    <h2 class="label">Languages</h2>
    <ul class="facts">
      {languages.map(({ data }) => <li>{data.name} <span>{data.level}</span></li>)}
    </ul>
  </section>

  <section class="section">
    <h2 class="label">Certificates</h2>
    <ul class="certificates">
      {certifications.map(({ data }) => (
        <li>
          <span class="cert-name">{data.name}</span>
          <span class="cert-meta">{data.issuer}, {data.month ? `${data.month}/` : ''}{data.year}</span>
          {data.note && <span class="cert-note">{data.note}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="label">Education</h2>
    <div>
      {education.map(({ data }) => (
        <Entry start={data.start} end={data.end} title={data.degree} place={data.school}>
          {data.thesis && <p>Thesis: {data.thesis}</p>}
          {data.note && <p>{data.note}</p>}
        </Entry>
      ))}
    </div>
  </section>
</Base>

<script>
  document.querySelector('.print')?.addEventListener('click', () => window.print());
</script>

<style>
  .intro {
    padding-block: clamp(3rem, 8vw, 5rem) 2.5rem;
  }
  .intro h1 {
    margin-top: 1rem;
  }
  .tagline {
    margin-top: 1rem;
    font-size: 1.1875rem;
    color: var(--muted);
  }
  .contact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    font-size: 0.9375rem;
  }
  .print {
    font: inherit;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    cursor: pointer;
  }
  .print:hover {
    color: var(--accent);
    border-color: currentColor;
  }
  .client + .client {
    margin-top: 2.75rem;
  }
  .client-name {
    font-family: var(--serif);
    font-size: 1.75rem;
    margin-bottom: 1.25rem;
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }
  .certificates {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .certificates li {
    display: grid;
    break-inside: avoid;
  }
  .cert-name {
    font-weight: 600;
  }
  .cert-meta,
  .cert-note {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .cert-meta {
    font: 400 0.8125rem/1.6 var(--mono);
    color: var(--faint);
  }
  .facts span {
    color: var(--faint);
  }

  @media print {
    @page {
      margin: 16mm 14mm;
    }
    :global(:root) {
      --bg: #fff;
      --fg: #000;
      --muted: #333;
      --faint: #666;
      --line: #ccc;
      font-size: 10pt;
    }
    :global(a) {
      text-decoration: none;
    }
    .no-print {
      display: none;
    }
    .intro {
      padding-block: 0 1rem;
    }
    .intro h1 {
      font-size: 2.5rem;
    }
    /* the whole width of the paper for the content: the label of a section above it */
    :global(.section) {
      padding-block: 1.25rem;
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .client {
      break-inside: auto;
    }
    .client-name {
      font-size: 1.25rem;
      break-after: avoid;
    }
  }
</style>
