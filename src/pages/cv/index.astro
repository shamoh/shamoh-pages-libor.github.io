---
import EmailLink from '../../components/EmailLink.astro';
import { educations, experiences, interests, languages, projects, skills } from '../../lib/cv';
import { site } from '../../site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Curriculum Vitae :: {site.title}</title>
    <meta name="description" content="Libor Kramoliš Curriculum Vitae" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;0,900;1,300;1,400;1,500;1,700;1,900&display=swap" />
    <link rel="stylesheet" href="/cv/assets/plugins/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/cv/assets/plugins/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/cv/assets/css/styles.css" />
  </head>

  <body>
    <div class="wrapper">
      <div class="sidebar-wrapper">
        <div class="profile-container">
          <img class="profile-img" src={site.picture} alt="profile picture" />
          <h1 class="name">{site.name}</h1>
          <h3 class="tagline">{site.tagline}</h3>
        </div>

        <div class="contact-container container-block">
          <ul class="list-unstyled contact-list">
            <li class="email"><i class="fa fa-envelope"></i><EmailLink><Fragment set:html={site.email} /></EmailLink></li>
            <li class="website"><i class="fa fa-globe"></i><a href={`https://${site.website}`} target="_blank">{site.website}</a></li>
            <li class="linkedin"><i class="fa fa-linkedin"></i><a href={`https://linkedin.com/in/${site.linkedin}`} target="_blank">{site.linkedin}</a></li>
            <li class="github"><i class="fa fa-github"></i><a href={`https://github.com/${site.github}`} target="_blank">{site.github}</a></li>
            <li class="twitter"><i class="fa fa-twitter"></i><a href={`https://twitter.com/${site.twitter}`} target="_blank">{site.twitter}</a></li>
          </ul>
        </div>

        {educations.length > 0 && (
          <div class="education-container container-block">
            <h2 class="container-block-title">Education</h2>
            {educations.map((education) => (
              <div class="item">
                <h4 class="degree">{education.degree}</h4>
                <h5 class="meta">{education.university}</h5>
                <div class="time">{education.time}</div>
              </div>
            ))}
          </div>
        )}

        {languages.length > 0 && (
          <div class="languages-container container-block">
            <h2 class="container-block-title">Languages</h2>
            <ul class="list-unstyled interests-list">
              {languages.map((language) => (
                <li>{language.idiom} <span class="lang-desc">({language.level})</span></li>
              ))}
            </ul>
          </div>
        )}

        {interests.length > 0 && (
          <div class="interests-container container-block">
            <h2 class="container-block-title">Interests</h2>
            <ul class="list-unstyled interests-list">
              {interests.map((interest) => <li>{interest.item}</li>)}
            </ul>
          </div>
        )}

        {skills.length > 0 && (
          <div class="languages-container container-block">
            <h2 class="container-block-title">Skills &amp; Proficiency</h2>
            <ul class="list-unstyled interests-list">
              {skills.map((skill) => (
                <li>{skill.name} {skill.level && <span class="lang-desc">({skill.level})</span>}</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="main-wrapper">
        <section class="section summary-section">
          <h2 class="section-title"><i class="fa fa-user"></i>Career Profile</h2>
          <div class="summary">
            <Fragment set:html={site.summary} />
          </div>
        </section>

        <section class="section experiences-section">
          <h2 class="section-title"><i class="fa fa-briefcase"></i>Experiences</h2>
          {experiences.map((experience) => (
            <div class="item">
              <div class="meta">
                <div class="upper-row">
                  <h3 class="job-title">{experience.role}</h3>
                  <div class="time">{experience.time}</div>
                </div>
                <div class="company">{experience.company}</div>
              </div>
              {experience.details && (
                <div class="details">
                  <p>{experience.details}</p>
                </div>
              )}
            </div>
          ))}
        </section>

        <section class="section projects-section">
          <h2 class="section-title"><i class="fa fa-archive"></i>Selected Projects</h2>
          {projects.map((company) => (
            <>
              <h3 class="company">{company.name}</h3>
              {company.projects.map((project) => (
                <div class="item">
                  <div class="meta">
                    <div class="upper-row">
                      <h4>{project.name}</h4>
                      <div class="time">{project.time}</div>
                    </div>
                  </div>
                  {project.details && <span class="project-tagline">{project.details}</span>}
                  {project.responsibilities && (
                    <ul>
                      {project.responsibilities.map((responsibility) => <li>{responsibility}</li>)}
                    </ul>
                  )}
                  {project.technologies && <span>Technologies: {project.technologies}.</span>}
                </div>
              ))}
            </>
          ))}
        </section>
      </div>
    </div>
  </body>
</html>
