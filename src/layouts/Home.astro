---
import GoUp from '../components/GoUp.astro';
import Head from '../components/Head.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Nav from '../components/Nav.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../site';
---

<!doctype html>
<html lang="en">
  <Head />
  <body>
    <MobileMenu />
    <div class="baslik">{site.title}</div>
    <div class="orta">
      <div class="ortala">
        <div class="resim">
          <img alt={site.title} src={site.picture} />
        </div>
        <div class="pc">
          <Nav variant="home" />
        </div>
        <div class="aciklamalar">{site.description}</div>
      </div>
    </div>
    <SocialLinks />
    <GoUp />
  </body>
</html>
